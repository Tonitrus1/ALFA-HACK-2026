VITE_API_MODE=mock
# Указать только после согласования временного контракта с backend:
# VITE_CONTRACT_ACK=provisional-v1
# BACKEND_ORIGIN=http://127.0.0.1:8080
# Только для MSW. success | rfi | manual | declined | network | conflict | ocr-failed
VITE_DEMO_SCENARIO=success

# Порт Docker Compose на этом компьютере
FRONTEND_PORT=8080
# Для backend на хосте в Docker Desktop: BACKEND_ORIGIN=http://host.docker.internal:8081
