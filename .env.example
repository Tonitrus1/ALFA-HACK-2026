# Generate random internal credentials: python3 scripts/integration/configure.py
COMPOSE_PROJECT_NAME=credit-integrated-mvp
BACKEND_DB_PASSWORD=
ML_ADMIN_PASSWORD=
ML_DB_PASSWORD=
ML_SERVICE_TOKEN=
ASSISTANT_SERVICE_TOKEN=
OCR_API_KEY=
DOCUMENT_OCR_TOKEN=
SEARXNG_SECRET=
CABINET_A_PASSWORD=
CABINET_B_PASSWORD=

# OpenAI-compatible LLM provider; only synthetic documents may be sent in this demo.
# Empty key: Risk/Feed/core work; Assistant/OCR readiness explicitly fails.
LLM_API_KEY=
LLM_BASE_URL=https://api.aitunnel.ru/v1
ASSISTANT_LLM_MODEL=qwen3-30b-a3b
OCR_LLM_MODEL=deepseek-v4.1-flash-1017
FEED_RELEASE=v1
FEED_RANKER=e5
FRAUD_MODE=off

# CPU defaults; adjust to the resources allocated to Docker, not host totals.
OCR_CPU_THREADS=2
# Used by scripts/deploy.py up --mode local (downloaded once, served in Docker).
LOCAL_RAG_MODEL=qwen2.5:3b
LOCAL_OCR_MODEL=qwen2.5:3b
