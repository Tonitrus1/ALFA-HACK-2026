<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Версии — документальные ориентиры HACKATHON-1.5; точные locks закрывает P02. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>ru.alfahack.credit</groupId>
    <artifactId>credit-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>credit-backend</name>
    <description>Кредитный кабинет предпринимателя — backend</description>

    <modules>
        <module>ports</module>
        <module>adapters/local</module>
        <module>adapters/redis</module>
        <module>adapters/kafka</module>
        <module>adapters/s3</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ru.alfahack.credit</groupId>
                <artifactId>credit-ports</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.alfahack.credit</groupId>
                <artifactId>credit-adapters-local</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.alfahack.credit</groupId>
                <artifactId>credit-adapters-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.alfahack.credit</groupId>
                <artifactId>credit-adapters-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.alfahack.credit</groupId>
                <artifactId>credit-adapters-s3</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
