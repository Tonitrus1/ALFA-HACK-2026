{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DatasetManifest",
  "$defs": {
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fallbackAction": {
          "type": "string",
          "enum": [
            "MANUAL_REVIEW",
            "RULES",
            "MANUAL_INPUT",
            "SEARCH_ONLY",
            "RETRY_LATER",
            "NONE"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "correlationId"
      ],
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "operationId",
        "status",
        "resourceId"
      ],
      "additionalProperties": false
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "objectVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "bucket",
        "key",
        "objectVersion",
        "sha256"
      ],
      "additionalProperties": false
    },
    "DocumentReference": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "documentVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "objectVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "documentId",
        "documentVersion",
        "objectVersion"
      ],
      "additionalProperties": false
    },
    "FinancialValues": {
      "type": "object",
      "properties": {
        "totalAssetsMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalLiabilitiesMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currentAssetsMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currentLiabilitiesMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "equityMinor": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "revenueMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "netProfitMinor": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ebitMinor": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "FinancialInput": {
      "type": "object",
      "properties": {
        "periodStart": {
          "type": "string",
          "format": "date"
        },
        "periodEnd": {
          "type": "string",
          "format": "date"
        },
        "reportingStandard": {
          "type": "string",
          "enum": [
            "DEMO",
            "RSBU",
            "IFRS"
          ]
        },
        "currency": {
          "const": "RUB"
        },
        "values": {
          "$ref": "#/$defs/FinancialValues"
        },
        "sourceDocumentReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentReference"
          },
          "minItems": 0,
          "maxItems": 10
        }
      },
      "required": [
        "periodStart",
        "periodEnd",
        "reportingStandard",
        "currency",
        "values",
        "sourceDocumentReferences"
      ],
      "additionalProperties": false
    },
    "FinancialConfirmation": {
      "type": "object",
      "properties": {
        "expectedStatementVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "confirmedFieldNames": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "totalAssetsMinor",
              "totalLiabilitiesMinor",
              "currentAssetsMinor",
              "currentLiabilitiesMinor",
              "equityMinor",
              "revenueMinor",
              "netProfitMinor",
              "ebitMinor"
            ]
          },
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true
        },
        "documentReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentReference"
          },
          "minItems": 0,
          "maxItems": 10
        }
      },
      "required": [
        "expectedStatementVersion",
        "confirmedFieldNames",
        "documentReferences"
      ],
      "additionalProperties": false
    },
    "FieldProvenance": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "totalAssetsMinor",
            "totalLiabilitiesMinor",
            "currentAssetsMinor",
            "currentLiabilitiesMinor",
            "equityMinor",
            "revenueMinor",
            "netProfitMinor",
            "ebitMinor"
          ]
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "MANUAL",
            "OCR"
          ]
        },
        "confirmedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time"
        },
        "extractionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "objectVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "field",
        "sourceType",
        "confirmedBy",
        "confirmedAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "OCR"
              }
            }
          },
          "then": {
            "required": [
              "extractionId",
              "objectVersion"
            ]
          }
        }
      ]
    },
    "FinancialStatement": {
      "type": "object",
      "properties": {
        "statementVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "containerVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "confirmed": {
          "type": "boolean"
        },
        "statement": {
          "$ref": "#/$defs/FinancialInput"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldProvenance"
          },
          "minItems": 0,
          "maxItems": 8
        }
      },
      "required": [
        "statementVersion",
        "containerVersion",
        "confirmed",
        "statement",
        "provenance"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "confirmed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "statement": {
                "properties": {
                  "values": {
                    "required": [
                      "totalAssetsMinor",
                      "totalLiabilitiesMinor",
                      "currentAssetsMinor",
                      "currentLiabilitiesMinor",
                      "equityMinor",
                      "revenueMinor",
                      "netProfitMinor",
                      "ebitMinor"
                    ]
                  }
                }
              },
              "provenance": {
                "minItems": 8
              }
            }
          }
        }
      ]
    },
    "FeatureSnapshotInput": {
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "submissionSnapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "financialStatementVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "DEMO_RESEARCH",
            "CREDIT_RISK"
          ]
        }
      },
      "required": [
        "applicationId",
        "submissionSnapshotId",
        "financialStatementVersion",
        "asOf",
        "purpose"
      ],
      "additionalProperties": false
    },
    "FeatureSnapshot": {
      "type": "object",
      "properties": {
        "featureSnapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "submissionSnapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "financialStatementVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "featureSchemaVersion": {
          "const": 2
        },
        "featureCodeDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "featureAsOf": {
          "type": "string",
          "format": "date-time"
        },
        "latestSourceAvailableAt": {
          "type": "string",
          "format": "date-time"
        },
        "features": {
          "type": "object",
          "properties": {
            "X1": {
              "type": [
                "number",
                "null"
              ]
            },
            "X2": {
              "type": [
                "number",
                "null"
              ]
            },
            "X3": {
              "type": [
                "number",
                "null"
              ]
            },
            "X4": {
              "type": [
                "number",
                "null"
              ]
            },
            "X7": {
              "type": [
                "number",
                "null"
              ]
            },
            "X8": {
              "type": [
                "number",
                "null"
              ]
            },
            "X9": {
              "type": [
                "number",
                "null"
              ]
            },
            "X10": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "X1",
            "X2",
            "X3",
            "X4",
            "X7",
            "X8",
            "X9",
            "X10"
          ],
          "additionalProperties": false
        },
        "missingFeatures": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "X1",
              "X2",
              "X3",
              "X4",
              "X7",
              "X8",
              "X9",
              "X10"
            ]
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "snapshotDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "featureSnapshotId",
        "submissionSnapshotId",
        "financialStatementVersion",
        "featureSchemaVersion",
        "featureCodeDigest",
        "featureAsOf",
        "latestSourceAvailableAt",
        "features",
        "missingFeatures",
        "snapshotDigest"
      ],
      "additionalProperties": false
    },
    "RiskRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "featureSnapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "featureSnapshotDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "featureSchemaVersion": {
          "const": 2
        },
        "purpose": {
          "type": "string",
          "enum": [
            "DEMO_RESEARCH",
            "CREDIT_RISK"
          ]
        }
      },
      "required": [
        "requestId",
        "featureSnapshotId",
        "featureSnapshotDigest",
        "featureSchemaVersion",
        "purpose"
      ],
      "additionalProperties": false
    },
    "RiskResult": {
      "type": "object",
      "properties": {
        "inferenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scoreKind": {
          "type": "string",
          "enum": [
            "BANKRUPTCY_PROXY",
            "PD"
          ]
        },
        "calibrationStatus": {
          "type": "string",
          "enum": [
            "DEMONSTRATION",
            "VALIDATED"
          ]
        },
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bundleDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "featureSnapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "featureSnapshotDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "internalReasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "inferenceId",
        "requestId",
        "score",
        "scoreKind",
        "calibrationStatus",
        "releaseId",
        "bundleDigest",
        "modelVersion",
        "featureSnapshotId",
        "featureSnapshotDigest",
        "internalReasonCodes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scoreKind": {
                "const": "BANKRUPTCY_PROXY"
              }
            }
          },
          "then": {
            "properties": {
              "calibrationStatus": {
                "const": "DEMONSTRATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scoreKind": {
                "const": "PD"
              }
            }
          },
          "then": {
            "properties": {
              "calibrationStatus": {
                "const": "VALIDATED"
              }
            }
          }
        }
      ]
    },
    "RankingRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "type": "string",
          "enum": [
            "PRODUCT",
            "FEED"
          ]
        },
        "candidateIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "candidateSetDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalogVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "eligibilityVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contextCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fundingPurpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "requestId",
        "scope",
        "candidateIds",
        "candidateSetDigest",
        "catalogVersion",
        "stage",
        "contextCategory"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "PRODUCT"
              }
            }
          },
          "then": {
            "required": [
              "eligibilityVersion",
              "fundingPurpose"
            ]
          }
        }
      ]
    },
    "RankingResult": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "type": "string",
          "enum": [
            "PRODUCT",
            "FEED"
          ]
        },
        "rankedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "candidateSetDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "exposureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mode": {
          "type": "string",
          "enum": [
            "MODEL",
            "RULES"
          ]
        },
        "reasonCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "requestId",
        "scope",
        "rankedIds",
        "candidateSetDigest",
        "exposureId",
        "releaseId",
        "mode",
        "reasonCategory"
      ],
      "additionalProperties": false
    },
    "RecommendationFeedback": {
      "type": "object",
      "properties": {
        "clientEventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "exposureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "enum": [
            "VIEW",
            "CLICK",
            "HELPFUL",
            "NOT_INTERESTED"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "clientEventId",
        "exposureId",
        "itemId",
        "action",
        "occurredAt"
      ],
      "additionalProperties": false
    },
    "AssistantInput": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "documentVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunkId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourcePath": {
          "type": "string",
          "pattern": "^/api/v1/knowledge/[A-Za-z0-9_-]+/versions/[1-9][0-9]*$"
        }
      },
      "required": [
        "documentId",
        "documentVersion",
        "chunkId",
        "title",
        "locator",
        "sourcePath"
      ],
      "additionalProperties": false
    },
    "AssistantResponse": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": [
            "ANSWER",
            "INSUFFICIENT_EVIDENCE",
            "SEARCH_ONLY"
          ]
        },
        "answer": {
          "type": "string",
          "maxLength": 4000
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 0,
          "maxItems": 5
        },
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bundleDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kbEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "conversationId",
        "messageId",
        "status",
        "answer",
        "citations",
        "releaseId",
        "bundleDigest",
        "kbEpoch"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ANSWER"
              }
            }
          },
          "then": {
            "properties": {
              "citations": {
                "minItems": 1
              },
              "answer": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "SEARCH_ONLY"
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "const": ""
              },
              "citations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "HiddenMessage": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "const": "HIDDEN_SOURCE_REVOKED"
        }
      },
      "required": [
        "messageId",
        "status"
      ],
      "additionalProperties": false
    },
    "Conversation": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "messages": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/AssistantResponse"
