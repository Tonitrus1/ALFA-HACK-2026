  "components": {
    "schemas": {
      "FeatureInput": {
        "properties": {
          "applicationId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Applicationid"
          },
          "submissionSnapshotId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Submissionsnapshotid"
          },
          "financialSnapshotId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Financialsnapshotid"
          },
          "financialSnapshotDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Financialsnapshotdigest"
          },
          "financialStatementVersion": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Financialstatementversion"
          },
          "asOf": {
            "type": "string",
            "title": "Asof"
          },
          "latestSourceAvailableAt": {
            "type": "string",
            "title": "Latestsourceavailableat"
          },
          "purpose": {
            "type": "string",
            "const": "DEMO_RESEARCH",
            "title": "Purpose"
          },
          "financialStatement": {
            "$ref": "#/components/schemas/FinancialInput"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "applicationId",
          "submissionSnapshotId",
          "financialSnapshotId",
          "financialSnapshotDigest",
          "financialStatementVersion",
          "asOf",
          "latestSourceAvailableAt",
          "purpose",
          "financialStatement"
        ],
        "title": "FeatureInput"
      },
      "FinancialInput": {
        "properties": {
          "periodStart": {
            "type": "string",
            "title": "Periodstart"
          },
          "periodEnd": {
            "type": "string",
            "title": "Periodend"
          },
          "reportingStandard": {
            "type": "string",
            "const": "DEMO",
            "title": "Reportingstandard"
          },
          "currency": {
            "type": "string",
            "const": "RUB",
            "title": "Currency"
          },
          "values": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Values"
          },
          "sourceDocumentReferences": {
            "items": {},
            "type": "array",
            "maxItems": 0,
            "title": "Sourcedocumentreferences"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "periodStart",
          "periodEnd",
          "reportingStandard",
          "currency",
          "values",
          "sourceDocumentReferences"
        ],
        "title": "FinancialInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RiskRequest": {
        "properties": {
          "requestId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Requestid"
          },
          "featureSnapshotId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Featuresnapshotid"
          },
          "featureSnapshotDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Featuresnapshotdigest"
          },
          "bundleDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Bundledigest"
          },
          "purpose": {
            "type": "string",
            "const": "DEMO_RESEARCH",
            "title": "Purpose"
          },
          "featureSchemaVersion": {
            "type": "integer",
            "const": 2,
            "title": "Featureschemaversion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "featureSnapshotId",
          "featureSnapshotDigest",
          "bundleDigest",
          "purpose",
          "featureSchemaVersion"
        ],
        "title": "RiskRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
