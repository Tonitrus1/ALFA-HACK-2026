# Internal service token. Set a random value before starting.
OCR_API_KEY=
OCR_ENGINE=tesseract
OCR_ENABLE_MKLDNN=true
# Development provider only; never put a key into Git or the frontend.
LLM_API_KEY=
LLM_BASE_URL=https://api.aitunnel.ru/v1
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_RESPONSE_FORMAT=json_object
LLM_REASONING=false
LLM_REASONING_OPTIONS=true
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=16000
LLM_VALIDATION_RETRIES=1
MAX_CONTEXT_CHARS=180000
DATA_DIR=/app/data
PROMPT_PATH=/app/prompts/extract.txt
SCHEMA_PATH=/app/schemas/extraction.schema.json
# Fixed 24h lifetime from submission; cleanup runs every 30 seconds.
# Upload: PDF/PNG/JPEG/TIFF, 10 files, 50 pages, 20 MiB/file, 100 MiB/batch.
