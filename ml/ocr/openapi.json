{
  "openapi": "3.1.0",
  "info": {
    "title": "ALFA standalone OCR",
    "description": "CPU OCR → external OpenAI-compatible LLM → validated JSON. Internal service; all values require user confirmation.",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/schema": {
      "get": {
        "summary": "Schema",
        "operationId": "schema_v1_schema_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/v1/jobs": {
      "post": {
        "summary": "Submit",
        "operationId": "submit_v1_jobs_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "files": {
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "type": "array",
                    "maxItems": 10,
                    "minItems": 1
                  }
                },
                "type": "object",
                "required": [
                  "files"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "summary": "Status",
        "operationId": "status_v1_jobs__job_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete",
        "operationId": "delete_v1_jobs__job_id__delete",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}/schema": {
      "get": {
        "summary": "Job Schema",
        "operationId": "job_schema_v1_jobs__job_id__schema_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}/result": {
      "get": {
        "summary": "Result",
        "operationId": "result_v1_jobs__job_id__result_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}/ocr": {
      "get": {
        "summary": "Ocr",
        "operationId": "ocr_v1_jobs__job_id__ocr_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OCRResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "const": "queued",
            "title": "Status",
            "default": "queued"
          },
          "expires_at": {
            "type": "number",
            "title": "Expires At"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "expires_at",
          "status_url"
        ],
        "title": "Accepted"
      },
      "Block": {
        "properties": {
          "block_id": {
            "type": "string",
            "title": "Block Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "bbox": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "block_id",
          "text",
          "confidence",
          "bbox"
        ],
        "title": "Block"
      },
      "Document": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "sha256",
          "media_type",
          "pages"
        ],
        "title": "Document"
      },
      "ExtractionResult": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "requires_confirmation": {
            "type": "boolean",
            "const": true,
            "title": "Requires Confirmation"
          },
          "extraction": {
            "additionalProperties": true,
            "type": "object",
            "title": "Extraction",
            "description": "Validated against the editable JSON Schema returned by GET /v1/schema; see schemas/extraction.schema.json for all typed fields."
          },
          "provenance": {
            "additionalProperties": true,
            "type": "object",
            "title": "Provenance",
            "description": "Prompt/schema hashes, OCR engine/version, LLM model/calls/usage/validation_repairs and elapsed seconds."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "requires_confirmation",
          "extraction",
          "provenance"
        ],
        "title": "ExtractionResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Job": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "succeeded",
              "failed"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "expires_at": {
            "type": "number",
            "title": "Expires At"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/Document"
            },
            "type": "array",
            "title": "Documents"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "stage": {
            "type": "string",
            "enum": [
              "queued",
              "ocr",
              "llm",
              "validation",
              "done"
            ],
            "title": "Stage",
            "default": "queued"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "status",
          "created_at",
          "expires_at",
          "documents"
        ],
        "title": "Job"
      },
      "OCRResult": {
        "properties": {
          "engine": {
            "type": "string",
            "enum": [
              "paddle",
              "tesseract"
            ],
            "title": "Engine"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/Page"
            },
            "type": "array",
            "title": "Pages"
          },
          "seconds": {
            "type": "number",
            "title": "Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "engine",
          "engine_version",
          "pages",
          "seconds"
        ],
        "title": "OCRResult"
      },
      "Page": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/Block"
            },
            "type": "array",
            "title": "Blocks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "page",
          "width",
          "height",
          "blocks"
        ],
        "title": "Page"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
