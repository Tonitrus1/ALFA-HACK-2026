  "components": {
    "schemas": {
      "BankContext": {
        "properties": {
          "company_id": {
            "type": "string",
            "title": "Company Id"
          },
          "products": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Products"
          },
          "applications": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 10000,
            "title": "Applications"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "company_id",
          "products",
          "applications"
        ],
        "title": "BankContext"
      },
      "Body_import_knowledge_v1_admin_knowledge_import_post": {
        "properties": {
          "metadata": {
            "type": "string",
            "title": "Metadata"
          },
          "file": {
            "anyOf": [
              {
                "type": "string",
                "format": "binary"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          }
        },
        "type": "object",
        "required": [
          "metadata"
        ],
        "title": "Body_import_knowledge_v1_admin_knowledge_import_post"
      },
      "ChatResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "message_id": {
            "type": "string",
            "title": "Message Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ANSWER",
              "INSUFFICIENT_EVIDENCE",
              "SEARCH_ONLY"
            ],
            "title": "Status"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/KnowledgeCitation"
                },
                {
                  "$ref": "#/components/schemas/WebCitation"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "KNOWLEDGE": "#/components/schemas/KnowledgeCitation",
                  "WEB": "#/components/schemas/WebCitation"
                }
              }
            },
            "type": "array",
            "title": "Citations"
          },
          "pending_actions": {
            "items": {
              "$ref": "#/components/schemas/PendingAction"
            },
            "type": "array",
            "title": "Pending Actions"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "context_truncated": {
            "type": "boolean",
            "title": "Context Truncated"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "message_id",
          "status",
          "answer",
          "citations",
          "pending_actions",
          "usage",
          "latency_ms",
          "context_truncated",
          "request_id"
        ],
        "title": "ChatResponse"
      },
      "ConfirmCandidate": {
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          },
          "allowed_use": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Allowed Use"
          },
          "attribution": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Attribution"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sha256",
          "allowed_use",
          "attribution"
        ],
        "title": "ConfirmCandidate"
      },
      "CreateSession": {
        "properties": {
          "identity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Identity"
              },
              {
                "type": "null"
              }
            ]
          },
          "demo_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Demo User Id"
          },
          "system_prompt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "System Prompt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateSession"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Identity": {
        "properties": {
          "actor_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
