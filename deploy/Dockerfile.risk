FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/ml OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY ml/requirements.txt /tmp/requirements.txt
COPY deploy/install.py /tmp/install.py
RUN --mount=type=cache,target=/root/.cache/pip python /tmp/install.py -r /tmp/requirements.txt
COPY ml/scoring ml/scoring
COPY ml/artifacts/baseline ml/artifacts/baseline
COPY ml/artifacts/fraud-demo-v1 ml/artifacts/fraud-demo-v1
COPY deploy/normalize_text.py /tmp/normalize_text.py
RUN python /tmp/normalize_text.py /app/ml
RUN useradd --uid 10001 --create-home service
USER service
CMD ["uvicorn", "scoring.server:app", "--host", "0.0.0.0", "--port", "8001", "--no-access-log"]

FROM runtime AS testing
USER root
RUN --mount=type=cache,target=/root/.cache/pip python /tmp/install.py pytest==8.3.5 requests==2.32.3 jsonschema==4.25.1 httpx==0.28.1
USER service
