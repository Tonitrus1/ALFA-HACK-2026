FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY deploy/install.py /tmp/install.py
RUN --mount=type=cache,target=/root/.cache/pip python /tmp/install.py torch==2.9.0 --index-url https://download.pytorch.org/whl/cpu
COPY ml/assistant/pyproject.toml ./
COPY deploy/constraints.cpu.txt /tmp/constraints.cpu.txt
RUN python -c "import tomllib; p=tomllib.load(open('pyproject.toml','rb'))['project']; print('\n'.join(p['dependencies'] + p['optional-dependencies']['models']))" > /tmp/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip python /tmp/install.py -c /tmp/constraints.cpu.txt -r /tmp/requirements.txt
ENV PYTHONPATH=/app/src
COPY ml/assistant/src ./src
COPY ml/assistant .
COPY deploy/assistant-start.sh /assistant-start.sh
COPY deploy/assistant-init.sh /assistant-init.sh
COPY deploy/normalize_text.py /tmp/normalize_text.py
RUN python /tmp/normalize_text.py /assistant-start.sh /assistant-init.sh
RUN useradd --uid 10001 --create-home service && mkdir -p data model-cache reports && chown -R service:service /app
USER service
CMD ["sh", "/assistant-start.sh"]
