FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY ml/assistant/pyproject.toml ./
COPY ml/assistant/src ./src
RUN pip install --no-cache-dir torch==2.9.0 --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir '.[models]'
COPY ml/assistant .
COPY deploy/assistant-start.sh /assistant-start.sh
COPY deploy/assistant-init.sh /assistant-init.sh
RUN useradd --uid 10001 --create-home service && mkdir -p data model-cache reports && chown -R service:service /app
USER service
CMD ["sh", "/assistant-start.sh"]
