FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgomp1 tesseract-ocr tesseract-ocr-rus tesseract-ocr-eng fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
# Default CPU engine is Tesseract; the original Paddle build remains in ml/ocr/Dockerfile.
COPY ml/ocr/pyproject.toml /tmp/ocr-project.toml
COPY deploy/install.py /tmp/install.py
RUN --mount=type=cache,target=/root/.cache/pip python -c "import tomllib; p=tomllib.load(open('/tmp/ocr-project.toml','rb')); print('\n'.join(d for d in p['project']['dependencies'] if not d.startswith(('paddleocr','paddlepaddle','paddlex'))))" > /tmp/requirements.txt && python /tmp/install.py -r /tmp/requirements.txt
COPY ml/ocr .
RUN useradd --uid 10002 --create-home service && mkdir -p data /data && chown -R service:service /app /data
USER service
CMD ["uvicorn", "alfa_ocr.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--no-access-log", "--log-level", "warning"]
