FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src/backend
COPY backend .
RUN mvn -B -ntp package -DskipTests
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
COPY --from=build /src/backend/app/target/credit-app-0.1.0-SNAPSHOT.jar app.jar
RUN useradd --uid 10001 --create-home service && mkdir /objects && chown service /objects
USER service
HEALTHCHECK --interval=3s --timeout=2s --start-period=60s --retries=30 CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8080; printf 'GET /actuator/health HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n' >&3; read -r line <&3; [[ \"$line\" == *\" 200 \"* ]]"]
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
