# Independent installation. Generate secrets with scripts/selectel.py init.
COMPOSE_PROJECT_NAME=credit-selectel
PUBLIC_DOMAIN=
ACME_EMAIL=
BACKEND_DB_PASSWORD=
ML_ADMIN_PASSWORD=
ML_DB_PASSWORD=
ML_SERVICE_TOKEN=
ASSISTANT_SERVICE_TOKEN=
OCR_API_KEY=
DOCUMENT_OCR_TOKEN=
SEARXNG_SECRET=
CABINET_A_PASSWORD=
CABINET_B_PASSWORD=

# RAG Qwen2.5 3B runs on this VM in Docker; no external key is needed for RAG.
LLM_MODE=local
LOCAL_RAG_MODEL=qwen2.5:3b
# OCR keeps its existing provider settings. Full startup still needs its key.
# ASSISTANT_LLM_MODEL is used only when explicitly selecting LLM_MODE=external.
LLM_API_KEY=
LLM_BASE_URL=https://api.aitunnel.ru/v1
ASSISTANT_LLM_MODEL=qwen3-30b-a3b
OCR_LLM_MODEL=deepseek-v4.1-flash-1017
FEED_RELEASE=v1
FEED_RANKER=e5
FRAUD_MODE=off
OCR_CPU_THREADS=2
